[Unit]
Description=GPT02 DEV independent Hub/Core evidence reader (read-only, Unix socket only)
Documentation=https://github.com/Travelintrips/AI-Task-Hub/pull/161
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3
ConditionPathExists=/etc/gpt02-dev/supabase-root-ca-2021.crt
ConditionPathExists=/etc/credstore.encrypted/gpt02-hub-evidence-reader-dsn
ConditionPathExists=/etc/credstore.encrypted/gpt02-core-evidence-reader-dsn

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/gpt02-reader-runtime
Environment=NODE_ENV=development
Environment=APP_ENV=development
Environment=GPT02_READER_SOCKET=/run/gpt02-reader/reader.sock
LoadCredentialEncrypted=hub-reader-dsn:/etc/credstore.encrypted/gpt02-hub-evidence-reader-dsn
LoadCredentialEncrypted=core-reader-dsn:/etc/credstore.encrypted/gpt02-core-evidence-reader-dsn
ExecStartPre=/usr/bin/test -r /etc/gpt02-dev/supabase-root-ca-2021.crt
ExecStartPre=/usr/bin/test -r /etc/credstore.encrypted/gpt02-hub-evidence-reader-dsn
ExecStartPre=/usr/bin/test -r /etc/credstore.encrypted/gpt02-core-evidence-reader-dsn
ExecStart=/usr/bin/node /opt/gpt02-reader-runtime/scripts/dev/gpt02-reader-runtime.mjs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=10s
UMask=0077
LimitNOFILE=256
MemoryMax=256M
TasksMax=32

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RuntimeDirectory=gpt02-reader
RuntimeDirectoryMode=0700
ReadOnlyPaths=/etc/gpt02-dev/supabase-root-ca-2021.crt /opt/gpt02-reader-runtime
ReadWritePaths=/run/gpt02-reader
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
