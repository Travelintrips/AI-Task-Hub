COMPOSE_PROJECT_NAME=ai-task-development
CONTAINER_NAME=ai-task-development
IMAGE_NAME=ai-task-hub
IMAGE_TAG=development
NODE_ENV=development
HOST_PORT=18081
APP_ENV_FILE=/etc/ai-task/development.env
GPT02_PUBLIC_TRUST_MOUNT_ENABLED=false
GPT02_PUBLIC_TRUST_DIR_HOST=/run/credentials/gpt02-dev
GPT02_PUBLIC_TRUST_CONFIG_DIR_HOST=/etc/gpt02-dev
