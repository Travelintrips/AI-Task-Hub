[Unit]
Description=Install and deliver the published CST-DEV Task 189 package

[Service]
Type=oneshot
UMask=0077
# Both paths are inside the same root-only credential store. The issuer
# atomically renames a complete encrypted file to the incoming path.
WorkingDirectory=/etc/credstore.encrypted
ExecStart=/usr/bin/mv -T -- gpt02-task189-preparer.incoming .gpt02-task189-received
ExecStart=/usr/bin/test -f .gpt02-task189-received
ExecStart=/usr/bin/test ! -L .gpt02-task189-received
ExecStart=/usr/bin/mv -T -- .gpt02-task189-received gpt02-task189-preparer
ExecStart=/usr/bin/systemctl restart gpt02-task189-delivery.service
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/etc/credstore.encrypted
ProtectHome=yes
